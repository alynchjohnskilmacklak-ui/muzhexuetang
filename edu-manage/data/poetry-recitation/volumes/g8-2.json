    {
      "id": "g8-2-006",
      "sequence": 6,
      "title": "望洞庭湖上张丞相",
      "titleAliases": [
        "望洞庭湖赠张丞相"
      ],
      "author": "孟浩然",
      "dynasty": "唐",
      "textbookSection": "课外古诗词诵读（一）",
      "contentType": "课外古诗词诵读",
      "genre": "五言律诗",
      "stanzas": [
        [
          "八月湖水平，涵虚混太清。",
          "气蒸云梦泽，波撼岳阳城。"
        ],
        [
          "欲济无舟楫，端居耻圣明。",
          "坐观垂钓者，徒有羡鱼情。"
        ]
      ],
      "meaningSummary": "诗人先写洞庭湖的壮阔景象，再以无舟渡湖为喻，含蓄表达希望得到举荐、施展抱负的愿望。",

    {
      "id": "g8-2-005",
      "sequence": 5,
      "title": "送杜少府之任蜀州",
      "author": "王勃",
      "dynasty": "唐",
      "textbookSection": "课外古诗词诵读（一）",
      "contentType": "课外古诗词诵读",
      "genre": "五言律诗",
      "stanzas": [
        [
          "城阙辅三秦，风烟望五津。",
          "与君离别意，同是宦游人。"
        ],
        [
          "海内存知己，天涯若比邻。",
          "无为在歧路，儿女共沾巾。"
        ]
      ],
      "meaningSummary": "诗人送别友人赴蜀，劝慰彼此同为宦游之人，真挚友情能超越空间阻隔。",
      "keyNotes": [

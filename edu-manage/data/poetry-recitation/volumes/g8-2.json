    {
      "id": "g8-2-002",
      "sequence": 2,
      "title": "蒹葭",
      "author": "《诗经·秦风》",
      "dynasty": "先秦",
      "textbookSection": "诗经二首",
      "contentType": "课内古诗",
      "genre": "《诗经》·四言诗",
      "stanzas": [
        [
          "蒹葭苍苍，白露为霜。",
          "所谓伊人，在水一方。",
          "溯洄从之，道阻且长。",
          "溯游从之，宛在水中央。"
        ],
        [
          "蒹葭萋萋，白露未晞。",
          "所谓伊人，在水之湄。",
          "溯洄从之，道阻且跻。",
          "溯游从之，宛在水中坻。"
        ],
        [
          "蒹葭采采，白露未已。",
          "所谓伊人，在水之涘。",
          "溯洄从之，道阻且右。",
          "溯游从之，宛在水中沚。"
        ]
      ],
      "meaningSummary": "诗人反复追寻水边的伊人却始终难以接近，营造出朦胧优美又惆怅的意境。",
      "keyNotes": [
        {
          "term": "蒹葭",
          "meaning": "芦苇"
        },
        {
          "term": "溯洄",
          "meaning": "逆流而上"
        },
        {
          "term": "晞",
          "meaning": "干"
        },
        {
          "term": "湄、涘",
          "meaning": "水边"
        }
      ],
      "assignmentPolicy": "教师或学校按范围布置",

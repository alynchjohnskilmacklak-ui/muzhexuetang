    {
      "id": "g8-2-007",
      "sequence": 7,
      "title": "石壕吏",
      "author": "杜甫",
      "dynasty": "唐",
      "textbookSection": "唐诗三首",
      "contentType": "课内诗歌",
      "genre": "叙事诗",
      "stanzas": [
        [
          "暮投石壕村，有吏夜捉人。",
          "老翁逾墙走，老妇出门看。"
        ],
        [
          "吏呼一何怒！妇啼一何苦！",
          "听妇前致词：三男邺城戍。",
          "一男附书至，二男新战死。",
          "存者且偷生，死者长已矣！",
          "室中更无人，惟有乳下孙。",
          "有孙母未去，出入无完裙。"
        ],
        [
          "老妪力虽衰，请从吏夜归。",
          "急应河阳役，犹得备晨炊。"
        ],
        [
          "夜久语声绝，如闻泣幽咽。",
          "天明登前途，独与老翁别。"
        ]
      ],
      "meaningSummary": "诗人借夜间差役抓丁和老妇应役的经历，展现战乱给普通百姓带来的沉重苦难。",
      "keyNotes": [
        {
          "term": "逾墙",
          "meaning": "翻墙"
        },
        {
          "term": "戍",
          "meaning": "驻守"
        },
        {
          "term": "老妪",
          "meaning": "老妇"
        },
        {
          "term": "幽咽",
          "meaning": "低沉轻微的哭声"
        }
      ],
      "assignmentPolicy": "教师或学校按范围布置",

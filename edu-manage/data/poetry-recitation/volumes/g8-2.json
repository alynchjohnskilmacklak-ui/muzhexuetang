    {
      "id": "g8-2-009",
      "sequence": 9,
      "title": "卖炭翁",
      "author": "白居易",
      "dynasty": "唐",
      "textbookSection": "唐诗三首",
      "contentType": "课内诗歌",
      "genre": "叙事诗",
      "stanzas": [
        [
          "卖炭翁，伐薪烧炭南山中。",
          "满面尘灰烟火色，两鬓苍苍十指黑。"
        ],
        [
          "卖炭得钱何所营？身上衣裳口中食。",
          "可怜身上衣正单，心忧炭贱愿天寒。",
          "夜来城外一尺雪，晓驾炭车辗冰辙。",
          "牛困人饥日已高，市南门外泥中歇。"
        ],
        [
          "翩翩两骑来是谁？黄衣使者白衫儿。",
          "手把文书口称敕，回车叱牛牵向北。",
          "一车炭，千余斤，宫使驱将惜不得。",
          "半匹红纱一丈绫，系向牛头充炭直。"
        ]
      ],
      "meaningSummary": "诗人描写卖炭老人辛苦烧炭却遭宫使掠夺，揭露宫市对百姓的压迫。",
      "keyNotes": [
        {
          "term": "何所营",
          "meaning": "做什么用"
        },
        {
          "term": "敕",
          "meaning": "皇帝的命令"
        },
        {
          "term": "直",
          "meaning": "同“值”，价钱"
        }
      ],
      "assignmentPolicy": "教师或学校按范围布置",

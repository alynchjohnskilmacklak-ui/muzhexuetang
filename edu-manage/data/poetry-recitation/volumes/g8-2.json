    {
      "id": "g8-2-010",
      "sequence": 10,
      "title": "题破山寺后禅院",
      "author": "常建",
      "dynasty": "唐",
      "textbookSection": "课外古诗词诵读（二）",
      "contentType": "课外古诗词诵读",
      "genre": "五言律诗",
      "stanzas": [
        [
          "清晨入古寺，初日照高林。",
          "竹径通幽处，禅房花木深。"
        ],
        [
          "山光悦鸟性，潭影空人心。",
          "万籁此都寂，但余钟磬音。"
        ]

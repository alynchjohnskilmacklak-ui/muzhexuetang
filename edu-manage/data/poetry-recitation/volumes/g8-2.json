    {
      "id": "g8-2-004",
      "sequence": 4,
      "title": "子衿",
      "author": "《诗经·郑风》",
      "dynasty": "先秦",
      "textbookSection": "课外古诗词诵读（一）",
      "contentType": "课外古诗词诵读",
      "genre": "《诗经》·四言诗",
      "stanzas": [
        [
          "青青子衿，悠悠我心。",
          "纵我不往，子宁不嗣音？"
        ],
        [
          "青青子佩，悠悠我思。",
          "纵我不往，子宁不来？"
        ],
        [
          "挑兮达兮，在城阙兮。",
          "一日不见，如三月兮！"
        ]
      ],
      "meaningSummary": "诗中女子等待恋人不至，思念、埋怨和焦急交织，最后直抒一日不见如隔三月之情。",
      "keyNotes": [
        {
          "term": "子衿",
          "meaning": "你的衣领"
        },
        {
          "term": "嗣音",
          "meaning": "继续传递音讯"
        },
        {
          "term": "挑达",
          "meaning": "独自徘徊的样子"
        }
      ],

          "meaning": "僧人居住的房舍"
        },
        {
          "term": "万籁",
          "meaning": "各种声响"
        },
        {
          "term": "钟磬",
          "meaning": "寺院中的钟和磬"
        }
      ],
      "assignmentPolicy": "教师或学校按范围布置",

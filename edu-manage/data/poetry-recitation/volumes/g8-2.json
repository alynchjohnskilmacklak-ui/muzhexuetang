    {
      "id": "g8-2-008",
      "sequence": 8,
      "title": "茅屋为秋风所破歌",
      "author": "杜甫",
      "dynasty": "唐",
      "textbookSection": "唐诗三首",
      "contentType": "课内诗歌",
      "genre": "歌行体",
      "stanzas": [
        [
          "八月秋高风怒号，卷我屋上三重茅。",
          "茅飞渡江洒江郊，高者挂罥长林梢，下者飘转沉塘坳。"
        ],
        [
          "南村群童欺我老无力，忍能对面为盗贼。",
          "公然抱茅入竹去，唇焦口燥呼不得，归来倚杖自叹息。"
        ],
        [
          "俄顷风定云墨色，秋天漠漠向昏黑。",
          "布衾多年冷似铁，娇儿恶卧踏里裂。",
          "床头屋漏无干处，雨脚如麻未断绝。",
          "自经丧乱少睡眠，长夜沾湿何由彻！"
        ],
        [
          "安得广厦千万间，大庇天下寒士俱欢颜！",
          "风雨不动安如山。",
          "呜呼！何时眼前突兀见此屋，吾庐独破受冻死亦足！"
        ]
      ],
      "meaningSummary": "诗人由自家茅屋被风雨所破写到天下寒士的困苦，抒发推己及人的忧民情怀和济世理想。",
      "keyNotes": [
        {
          "term": "挂罥",
          "meaning": "缠挂"
        },
        {
          "term": "俄顷",
          "meaning": "一会儿"
        },
        {
          "term": "何由彻",
          "meaning": "如何挨到头"
        },
        {
          "term": "大庇",
          "meaning": "广泛庇护"
        }
      ],
      "assignmentPolicy": "教师或学校按范围布置",

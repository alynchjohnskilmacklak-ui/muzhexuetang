    {
      "id": "g9-2-006",
      "sequence": 6,
      "title": "临江仙（夜登小阁，忆洛中旧游）",
      "author": "陈与义",
      "dynasty": "南宋",
      "textbookSection": "课外古诗词诵读",
      "contentType": "课外古诗词诵读",
      "genre": "词·临江仙",
      "stanzas": [
        [
          "忆昔午桥桥上饮，坐中多是豪英。",
          "长沟流月去无声。",
          "杏花疏影里，吹笛到天明。"
        ],
        [
          "二十余年如一梦，此身虽在堪惊。",
          "闲登小阁看新晴。",
          "古今多少事，渔唱起三更。"
        ]
      ],
      "meaningSummary": "词人追忆洛阳旧游和昔日豪英，感叹二十余年世事如梦，借渔歌表现旷达中的苍凉。",
      "keyNotes": [
        {
          "term": "午桥",
          "meaning": "洛阳附近的桥名"
        },
        {
          "term": "堪惊",
          "meaning": "令人惊叹、感慨"
        },
        {
          "term": "三更",
          "meaning": "深夜"
        }
      ],
      "assignmentPolicy": "教师或学校按范围布置",

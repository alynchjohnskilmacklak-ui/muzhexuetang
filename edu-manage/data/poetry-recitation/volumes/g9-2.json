    {
      "id": "g9-2-007",
      "sequence": 7,
      "title": "太常引（建康中秋夜为吕叔潜赋）",
      "author": "辛弃疾",
      "dynasty": "南宋",
      "textbookSection": "课外古诗词诵读",
      "contentType": "课外古诗词诵读",
      "genre": "词·太常引",
      "stanzas": [
        [
          "一轮秋影转金波，飞镜又重磨。",
          "把酒问姮娥：被白发、欺人奈何？"
        ],
        [
          "乘风好去，长空万里，直下看山河。",
          "斫去桂婆娑，人道是、清光更多。"
        ]
      ],
      "meaningSummary": "词人借中秋问月表达年华易逝的感慨，并想象乘风俯瞰山河、扫除阴翳的豪情。",
      "keyNotes": [
        {
          "term": "姮娥",
          "meaning": "嫦娥"
        },
        {
          "term": "斫",
          "meaning": "砍、削"
        },
        {
          "term": "桂婆娑",
          "meaning": "月中桂树的枝叶"
        }
      ],
      "assignmentPolicy": "教师或学校按范围布置",

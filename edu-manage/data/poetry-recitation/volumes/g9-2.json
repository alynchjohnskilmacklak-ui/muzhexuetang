    {
      "id": "g9-2-002",
      "sequence": 2,
      "title": "江城子·密州出猎",
      "author": "苏轼",
      "dynasty": "北宋",
      "textbookSection": "词四首",
      "contentType": "课内词",
      "genre": "词·江城子",
      "stanzas": [
        [
          "老夫聊发少年狂。左牵黄，右擎苍。",
          "锦帽貂裘，千骑卷平冈。"
        ],
        [
          "为报倾城随太守，亲射虎，看孙郎。",
          "酒酣胸胆尚开张。鬓微霜，又何妨！"
        ],
        [
          "持节云中，何日遣冯唐？",
          "会挽雕弓如满月，西北望，射天狼。"
        ]
      ],
      "meaningSummary": "词人描写出猎盛况，借孙权和冯唐典故抒写报国壮志及渴望得到重用的心情。",
      "keyNotes": [
        {
          "term": "擎苍",
          "meaning": "举着苍鹰"
        },
        {
          "term": "倾城",
          "meaning": "全城的人"
        },
        {
          "term": "天狼",
          "meaning": "此处指侵扰边境的敌人"
        }
      ],
      "assignmentPolicy": "教师或学校按范围布置",

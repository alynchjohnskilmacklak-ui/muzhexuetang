    {
      "id": "g9-2-004",
      "sequence": 4,
      "title": "满江红（小住京华）",
      "author": "秋瑾",
      "dynasty": "清",
      "textbookSection": "词四首",
      "contentType": "课内词",
      "genre": "词·满江红",
      "stanzas": [
        [
          "小住京华，早又是，中秋佳节。",
          "为篱下黄花开遍，秋容如拭。"
        ],
        [
          "四面歌残终破楚，八年风味徒思浙。",
          "苦将侬，强派作蛾眉，殊未屑！"
        ],
        [
          "身不得，男儿列；心却比，男儿烈。",
          "算平生肝胆，因人常热。"
        ],
        [
          "俗子胸襟谁识我？英雄末路当磨折。",
          "莽红尘，何处觅知音？青衫湿！"
        ]
      ],
      "meaningSummary": "词人借中秋秋景抒发身为女子却胸怀男儿壮志的豪情，也写出知音难觅的孤独。",
      "keyNotes": [
        {
          "term": "京华",
          "meaning": "京城"
        },
        {
          "term": "蛾眉",
          "meaning": "女子细长而弯的眉毛，借指女子"
        },
        {
          "term": "殊未屑",
          "meaning": "很不屑"
        }
      ],
      "assignmentPolicy": "教师或学校按范围布置",
      "crosswalk53": {

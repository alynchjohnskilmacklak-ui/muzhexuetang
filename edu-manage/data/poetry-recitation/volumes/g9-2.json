    {
      "id": "g9-2-008",
      "sequence": 8,
      "title": "浣溪沙（身向云山那畔行）",
      "author": "纳兰性德",
      "dynasty": "清",
      "textbookSection": "课外古诗词诵读",
      "contentType": "课外古诗词诵读",
      "genre": "词·浣溪沙",
      "stanzas": [
        [
          "身向云山那畔行，北风吹断马嘶声，深秋远塞若为情！"
        ],
        [
          "一抹晚烟荒戍垒，半竿斜日旧关城，古今幽恨几时平！"
        ]
      ],
      "meaningSummary": "词人远行边塞，写晚烟、荒垒和斜日下的旧关城，抒发苍凉幽怨的感受。",
      "keyNotes": [
        {
          "term": "那畔",
          "meaning": "那边"
        },
        {
          "term": "戍垒",
          "meaning": "边防营垒"
        },
        {
          "term": "若为情",
          "meaning": "怎能不令人动情"
        }
      ],

    {
      "id": "g9-2-005",
      "sequence": 5,
      "title": "定风波（莫听穿林打叶声）",
      "author": "苏轼",
      "dynasty": "北宋",
      "textbookSection": "课外古诗词诵读",
      "contentType": "课外古诗词诵读",
      "genre": "词·定风波",
      "stanzas": [
        [
          "莫听穿林打叶声，何妨吟啸且徐行。",
          "竹杖芒鞋轻胜马，谁怕？一蓑烟雨任平生。"
        ],
        [
          "料峭春风吹酒醒，微冷，山头斜照却相迎。",
          "回首向来萧瑟处，归去，也无风雨也无晴。"
        ]
      ],
      "meaningSummary": "词人雨中徐行，面对风雨仍从容自若，借自然天气变化表达豁达的人生态度。",
      "keyNotes": [
        {
          "term": "吟啸",
          "meaning": "吟咏长啸"
        },
        {
          "term": "芒鞋",
          "meaning": "草鞋"
        },
        {
          "term": "料峭",
          "meaning": "形容微寒"
        }
      ],
      "assignmentPolicy": "教师或学校按范围布置",

  "items": [
    {
      "id": "g9-2-001",
      "sequence": 1,
      "title": "渔家傲·秋思",
      "author": "范仲淹",
      "dynasty": "北宋",
      "textbookSection": "词四首",
      "contentType": "课内词",
      "genre": "词·渔家傲",
      "stanzas": [
        [
          "塞下秋来风景异，衡阳雁去无留意。",
          "四面边声连角起，千嶂里，长烟落日孤城闭。"
        ],
        [
          "浊酒一杯家万里，燕然未勒归无计。",
          "羌管悠悠霜满地，人不寐，将军白发征夫泪。"
        ]
      ],
      "meaningSummary": "词人描写边塞秋景和孤城闭守，写出将士思乡却因战事未成而不能归的复杂心情。",
      "keyNotes": [
        {
          "term": "边声",
          "meaning": "边塞特有的声音"
        },
        {
          "term": "千嶂",
          "meaning": "层层叠叠的山峰"
        },
        {
          "term": "燕然未勒",
          "meaning": "尚未建立战功、边患未平"
        }
      ],
      "assignmentPolicy": "教师或学校按范围布置",

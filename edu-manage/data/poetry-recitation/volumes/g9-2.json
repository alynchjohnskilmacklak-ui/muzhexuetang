    {
      "id": "g9-2-003",
      "sequence": 3,
      "title": "破阵子·为陈同甫赋壮词以寄之",
      "author": "辛弃疾",
      "dynasty": "南宋",
      "textbookSection": "词四首",
      "contentType": "课内词",
      "genre": "词·破阵子",
      "stanzas": [
        [
          "醉里挑灯看剑，梦回吹角连营。",
          "八百里分麾下炙，五十弦翻塞外声，沙场秋点兵。"
        ],
        [
          "马作的卢飞快，弓如霹雳弦惊。",
          "了却君王天下事，赢得生前身后名。",
          "可怜白发生！"
        ]
      ],
      "meaningSummary": "词人以梦境再现军营生活和战斗场面，表达收复失地、建功立业的壮志及理想落空的悲愤。",
      "keyNotes": [
        {
          "term": "八百里",
          "meaning": "指牛"
        },
        {
          "term": "麾下",
          "meaning": "部下"
        },
        {
          "term": "了却",
          "meaning": "完成"
        },
        {
          "term": "可怜",
          "meaning": "可惜"
        }
      ],
      "assignmentPolicy": "教师或学校按范围布置",
      "crosswalk53": {

    {
      "id": "g7-2-003",
      "sequence": 3,
      "title": "春夜洛城闻笛",
      "author": "李白",
      "dynasty": "唐",
      "textbookSection": "课外古诗词诵读（一）",
      "contentType": "课外古诗词诵读",
      "genre": "七言绝句",
      "stanzas": [
        [
          "谁家玉笛暗飞声，散入春风满洛城。",
          "此夜曲中闻折柳，何人不起故园情。"
        ]
      ],
      "meaningSummary": "春夜笛声传遍洛阳，听到离别曲《折杨柳》，诗人由己及人地想到游子的故园之思。",
      "keyNotes": [

    {
      "id": "g7-2-002",
      "sequence": 2,
      "title": "竹里馆",
      "author": "王维",
      "dynasty": "唐",
      "textbookSection": "课外古诗词诵读（一）",
      "contentType": "课外古诗词诵读",
      "genre": "五言绝句",
      "stanzas": [
        [
          "独坐幽篁里，弹琴复长啸。",
          "深林人不知，明月来相照。"
        ]
      ],
      "meaningSummary": "诗人独坐幽深竹林，弹琴长啸，与明月相伴，写出宁静淡泊、自得其乐的心境。",
      "keyNotes": [
        {
          "term": "幽篁",
          "meaning": "幽深的竹林"
        },
        {
          "term": "长啸",
          "meaning": "撮口发出清越悠长的声音"
        }
      ],
      "assignmentPolicy": "教师或学校按范围布置",

    {
      "id": "g7-2-006",
      "sequence": 6,
      "title": "登幽州台歌",
      "author": "陈子昂",
      "dynasty": "唐",
      "textbookSection": "古代诗歌五首",
      "contentType": "课内古诗",
      "genre": "古体诗",
      "stanzas": [

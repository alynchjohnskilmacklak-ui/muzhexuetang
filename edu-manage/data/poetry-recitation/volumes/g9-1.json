    {
      "id": "g9-1-009",
      "sequence": 9,
      "title": "白雪歌送武判官归京",
      "author": "岑参",
      "dynasty": "唐",
      "textbookSection": "诗词曲五首",
      "contentType": "课内古诗",
      "genre": "歌行体",
      "stanzas": [
        [
          "北风卷地白草折，胡天八月即飞雪。",
          "忽如一夜春风来，千树万树梨花开。"
        ],
        [
          "散入珠帘湿罗幕，狐裘不暖锦衾薄。",
          "将军角弓不得控，都护铁衣冷难着。"
        ],
        [
          "瀚海阑干百丈冰，愁云惨淡万里凝。",
          "中军置酒饮归客，胡琴琵琶与羌笛。"
        ],
        [
          "纷纷暮雪下辕门，风掣红旗冻不翻。",
          "轮台东门送君去，去时雪满天山路。",
          "山回路转不见君，雪上空留马行处。"
        ]
      ],
      "meaningSummary": "诗人先写边塞奇寒和壮丽雪景，再写设宴送别，以雪中空留马迹收束惜别之情。",
      "keyNotes": [
        {
          "term": "白草",
          "meaning": "西北地区的一种草"
        },
        {
          "term": "瀚海",
          "meaning": "沙漠"
        },
        {
          "term": "掣",
          "meaning": "拉、扯"
        }
      ],
      "assignmentPolicy": "教师或学校按范围布置",

          "term": "始",
          "meaning": "才"
        },
        {
          "term": "冢",
          "meaning": "坟墓"
        },
        {
          "term": "旅谷",
          "meaning": "野生的谷子"
        },
        {
          "term": "贻",
          "meaning": "送给"
        }
      ],

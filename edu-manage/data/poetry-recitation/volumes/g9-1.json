    {
      "id": "g9-1-004",
      "sequence": 4,
      "title": "月夜忆舍弟",
      "author": "杜甫",
      "dynasty": "唐",
      "textbookSection": "课外古诗词诵读（一）",
      "contentType": "课外古诗词诵读",
      "genre": "五言律诗",
      "stanzas": [
        [
          "戍鼓断人行，边秋一雁声。",
          "露从今夜白，月是故乡明。"
        ],
        [
          "有弟皆分散，无家问死生。",
          "寄书长不达，况乃未休兵。"
        ]
      ],
      "meaningSummary": "战乱中的秋夜，诗人听鼓望月，牵挂离散的兄弟和故乡，忧思深切。",
      "keyNotes": [
        {
          "term": "舍弟",
          "meaning": "对自己弟弟的谦称"
        },
        {
          "term": "戍鼓",
          "meaning": "戍楼上的鼓声"
        },
        {
          "term": "况乃",
          "meaning": "何况是"
        }
      ],

  "items": [
    {
      "id": "g9-1-001",
      "sequence": 1,
      "title": "行路难（其一）",
      "author": "李白",
      "dynasty": "唐",
      "textbookSection": "诗词三首",
      "contentType": "课内古诗",
      "genre": "乐府古体诗",
      "stanzas": [
        [
          "金樽清酒斗十千，玉盘珍羞直万钱。",
          "停杯投箸不能食，拔剑四顾心茫然。"
        ],
        [
          "欲渡黄河冰塞川，将登太行雪满山。",
          "闲来垂钓碧溪上，忽复乘舟梦日边。"
        ],
        [
          "行路难！行路难！多歧路，今安在？",
          "长风破浪会有时，直挂云帆济沧海。"
        ]
      ],
      "meaningSummary": "诗人面对仕途阻碍而苦闷彷徨，最终以乘风破浪的信念表达对理想的坚定追求。",
      "keyNotes": [
        {
          "term": "珍羞",
          "meaning": "珍贵的菜肴"
        },
        {
          "term": "投箸",
          "meaning": "丢下筷子"
        },
        {
          "term": "济",
          "meaning": "渡"
        }
      ],
      "assignmentPolicy": "教师或学校按范围布置",

    {
      "id": "g9-1-005",
      "sequence": 5,
      "title": "长沙过贾谊宅",
      "author": "刘长卿",
      "dynasty": "唐",
      "textbookSection": "课外古诗词诵读（一）",
      "contentType": "课外古诗词诵读",
      "genre": "七言律诗",
      "stanzas": [
        [
          "三年谪宦此栖迟，万古惟留楚客悲。",
          "秋草独寻人去后，寒林空见日斜时。"
        ],
        [
          "汉文有道恩犹薄，湘水无情吊岂知？",
          "寂寂江山摇落处，怜君何事到天涯。"
        ]
      ],
      "meaningSummary": "诗人凭吊贾谊，借古人被贬的遭遇抒发怀才不遇、感伤自身的情怀。",
      "keyNotes": [
        {
          "term": "谪宦",
          "meaning": "被贬谪、降职"

    {
      "id": "g9-1-003",
      "sequence": 3,
      "title": "水调歌头（明月几时有）",
      "author": "苏轼",
      "dynasty": "北宋",
      "textbookSection": "诗词三首",
      "contentType": "课内词",
      "genre": "词·水调歌头",
      "stanzas": [
        [
          "明月几时有？把酒问青天。",
          "不知天上宫阙，今夕是何年。",
          "我欲乘风归去，又恐琼楼玉宇，高处不胜寒。",
          "起舞弄清影，何似在人间。"
        ],
        [
          "转朱阁，低绮户，照无眠。",
          "不应有恨，何事长向别时圆？",
          "人有悲欢离合，月有阴晴圆缺，此事古难全。",
          "但愿人长久，千里共婵娟。"
        ]
      ],
      "meaningSummary": "词人由望月遐想转向思念亲人，最终以豁达胸襟祝愿天下离人长久团圆。",
      "keyNotes": [
        {
          "term": "把酒",
          "meaning": "端起酒杯"
        },
        {
          "term": "不胜寒",
          "meaning": "禁受不住寒冷"
        },
        {
          "term": "婵娟",
          "meaning": "这里指月亮"
        }
      ],
      "assignmentPolicy": "教师或学校按范围布置",
      "crosswalk53": {

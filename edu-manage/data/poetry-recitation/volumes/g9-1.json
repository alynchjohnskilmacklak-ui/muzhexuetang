    {
      "id": "g9-1-006",
      "sequence": 6,
      "title": "左迁至蓝关示侄孙湘",
      "author": "韩愈",
      "dynasty": "唐",
      "textbookSection": "课外古诗词诵读（一）",
      "contentType": "课外古诗词诵读",
      "genre": "七言律诗",
      "stanzas": [
        [
          "一封朝奏九重天，夕贬潮州路八千。",
          "欲为圣明除弊事，肯将衰朽惜残年！"
        ],
        [
          "云横秦岭家何在？雪拥蓝关马不前。",
          "知汝远来应有意，好收吾骨瘴江边。"
        ]
      ],
      "meaningSummary": "诗人因直言进谏遭贬，表达忠而获罪的愤懑，也写出前途艰险和对亲人的牵挂。",

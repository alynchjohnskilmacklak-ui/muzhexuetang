    {
      "id": "g9-1-002",
      "sequence": 2,
      "title": "酬乐天扬州初逢席上见赠",
      "author": "刘禹锡",
      "dynasty": "唐",
      "textbookSection": "诗词三首",
      "contentType": "课内古诗",
      "genre": "七言律诗",
      "stanzas": [
        [
          "巴山楚水凄凉地，二十三年弃置身。",
          "怀旧空吟闻笛赋，到乡翻似烂柯人。"
        ],
        [
          "沉舟侧畔千帆过，病树前头万木春。",
          "今日听君歌一曲，暂凭杯酒长精神。"
        ]
      ],
      "meaningSummary": "诗人回顾贬谪经历和人事变迁，借沉舟、病树写出新旧更替，并表现乐观豁达。",
      "keyNotes": [
        {
          "term": "闻笛赋",
          "meaning": "向秀悼念旧友的典故"
        },
        {
          "term": "烂柯人",
          "meaning": "指久别返乡、恍如隔世之人"
        },
        {
          "term": "长精神",
          "meaning": "振作精神"
        }
      ],
      "assignmentPolicy": "教师或学校按范围布置",

    {
      "id": "g8-1-007",
      "sequence": 7,
      "title": "龟虽寿",
      "author": "曹操",
      "dynasty": "东汉末",
      "textbookSection": "课外古诗词诵读（一）",
      "contentType": "课外古诗词诵读",
      "genre": "乐府诗",
      "stanzas": [
        [
          "神龟虽寿，犹有竟时；",
          "腾蛇乘雾，终为土灰。"
        ],
        [
          "老骥伏枥，志在千里；",
          "烈士暮年，壮心不已。"
        ],
        [
          "盈缩之期，不但在天；",
          "养怡之福，可得永年。"
        ],
        [
          "幸甚至哉，歌以咏志。"
        ]
      ],
      "meaningSummary": "诗人先写生命终有尽头，再以老骥自喻，表达老当益壮、积极进取的精神。",
      "keyNotes": [
        {
          "term": "竟",
          "meaning": "终结"
        },
        {
          "term": "伏枥",
          "meaning": "伏在马槽边"
        },
        {
          "term": "养怡",
          "meaning": "调养身心"
        }
      ],

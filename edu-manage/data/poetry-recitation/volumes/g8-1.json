    {
      "id": "g8-1-001",
      "sequence": 1,
      "title": "野望",
      "author": "王绩",
      "dynasty": "唐",
      "textbookSection": "唐诗五首",
      "contentType": "课内古诗",
      "genre": "五言律诗",
      "stanzas": [
        [
          "东皋薄暮望，徙倚欲何依。",
          "树树皆秋色，山山唯落晖。"
        ],
        [
          "牧人驱犊返，猎马带禽归。",
          "相顾无相识，长歌怀采薇。"
        ]
      ],
      "meaningSummary": "诗人薄暮登高远望，面对秋景和归人反衬自己的孤独，借采薇典故表达隐逸之思。",
      "keyNotes": [
        {
          "term": "东皋",
          "meaning": "作者隐居之地"
        },
        {
          "term": "徙倚",
          "meaning": "徘徊"
        },
        {
          "term": "采薇",
          "meaning": "借指隐居不仕"
        }
      ],
      "assignmentPolicy": "教师或学校按范围布置",

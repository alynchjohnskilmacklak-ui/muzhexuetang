    {
      "id": "g8-1-012",
      "sequence": 12,
      "title": "雁门太守行",
      "author": "李贺",
      "dynasty": "唐",
      "textbookSection": "诗词五首",
      "contentType": "课内古诗",
      "genre": "七言古诗",
      "stanzas": [
        [
          "黑云压城城欲摧，甲光向日金鳞开。",
          "角声满天秋色里，塞上燕脂凝夜紫。"
        ],
        [
          "半卷红旗临易水，霜重鼓寒声不起。",

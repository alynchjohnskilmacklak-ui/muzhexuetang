    {
      "id": "g8-1-003",
      "sequence": 3,
      "title": "使至塞上",
      "author": "王维",
      "dynasty": "唐",
      "textbookSection": "唐诗五首",
      "contentType": "课内古诗",
      "genre": "五言律诗",
      "stanzas": [
        [
          "单车欲问边，属国过居延。",
          "征蓬出汉塞，归雁入胡天。"
        ],
        [
          "大漠孤烟直，长河落日圆。",
          "萧关逢候骑，都护在燕然。"
        ]
      ],
      "meaningSummary": "诗人出使边塞，写沿途所见的苍茫景色，也流露出漂泊之感和对边地军情的关注。",
      "keyNotes": [
        {
          "term": "问边",
          "meaning": "慰问边关守军"
        },
        {
          "term": "征蓬",
          "meaning": "飘飞的蓬草，常比喻远行之人"
        },
        {
          "term": "长河",
          "meaning": "黄河"
        }
      ],

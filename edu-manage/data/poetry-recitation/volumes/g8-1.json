    {
      "id": "g8-1-006",
      "sequence": 6,
      "title": "庭中有奇树",
      "author": "《古诗十九首》",
      "dynasty": "东汉",
      "textbookSection": "课外古诗词诵读（一）",
      "contentType": "课外古诗词诵读",
      "genre": "五言古诗",
      "stanzas": [
        [
          "庭中有奇树，绿叶发华滋。",
          "攀条折其荣，将以遗所思。"
        ],
        [
          "馨香盈怀袖，路远莫致之。",
          "此物何足贵？但感别经时。"
        ]
      ],
      "meaningSummary": "女子折花欲寄远人却无法送达，借花香盈袖写出离别已久、思念难寄的惆怅。",
      "keyNotes": [

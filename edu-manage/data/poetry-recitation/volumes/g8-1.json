    {
      "id": "g8-1-005",
      "sequence": 5,
      "title": "钱塘湖春行",
      "author": "白居易",
      "dynasty": "唐",
      "textbookSection": "唐诗五首",
      "contentType": "课内古诗",
      "genre": "七言律诗",
      "stanzas": [
        [
          "孤山寺北贾亭西，水面初平云脚低。",
          "几处早莺争暖树，谁家新燕啄春泥。"
        ],
        [
          "乱花渐欲迷人眼，浅草才能没马蹄。",
          "最爱湖东行不足，绿杨阴里白沙堤。"
        ]
      ],
      "meaningSummary": "诗人沿西湖春行，抓住早莺、新燕、浅草等初春景物，表达对湖上春景的喜爱。",
      "keyNotes": [
        {
          "term": "水面初平",
          "meaning": "春水初涨，水面刚与湖岸齐平"
        },
        {
          "term": "云脚",
          "meaning": "低垂的云"
        },
        {
          "term": "没马蹄",
          "meaning": "刚能遮住马蹄"
        }
      ],
      "assignmentPolicy": "教师或学校按范围布置",

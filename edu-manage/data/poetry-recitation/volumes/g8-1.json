    {
      "id": "g8-1-004",
      "sequence": 4,
      "title": "渡荆门送别",
      "author": "李白",
      "dynasty": "唐",
      "textbookSection": "唐诗五首",
      "contentType": "课内古诗",
      "genre": "五言律诗",
      "stanzas": [
        [
          "渡远荆门外，来从楚国游。",
          "山随平野尽，江入大荒流。"
        ],
        [
          "月下飞天镜，云生结海楼。",
          "仍怜故乡水，万里送行舟。"
        ]
      ],
      "meaningSummary": "诗人初次出蜀远游，描绘江行途中景色的变化，并以故乡水抒写眷恋之情。",
      "keyNotes": [
        {
          "term": "从",
          "meaning": "往"
        },
        {
          "term": "大荒",
          "meaning": "辽远无际的原野"
        },
        {
          "term": "怜",
          "meaning": "喜爱"
        }
      ],

    {
      "id": "g8-1-002",
      "sequence": 2,
      "title": "黄鹤楼",
      "author": "崔颢",
      "dynasty": "唐",
      "textbookSection": "唐诗五首",
      "contentType": "课内古诗",
      "genre": "七言律诗",
      "stanzas": [
        [
          "昔人已乘黄鹤去，此地空余黄鹤楼。",
          "黄鹤一去不复返，白云千载空悠悠。"
        ],
        [
          "晴川历历汉阳树，芳草萋萋鹦鹉洲。",
          "日暮乡关何处是？烟波江上使人愁。"
        ]
      ],
      "meaningSummary": "诗人由黄鹤楼传说转向眼前江景，抒发日暮时浓重的思乡之愁。",
      "keyNotes": [
        {
          "term": "历历",
          "meaning": "分明的样子"
        },
        {
          "term": "萋萋",
          "meaning": "草木茂盛的样子"
        },
        {
          "term": "乡关",
          "meaning": "故乡"
        }
      ],
      "assignmentPolicy": "教师或学校按范围布置",

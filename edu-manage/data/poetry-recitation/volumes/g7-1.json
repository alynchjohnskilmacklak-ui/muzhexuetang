    {
      "id": "g7-1-005",
      "sequence": 5,
      "title": "峨眉山月歌",
      "author": "李白",
      "dynasty": "唐",
      "textbookSection": "课外古诗词诵读（一）",
      "contentType": "课外古诗词诵读",
      "genre": "七言绝句",
      "stanzas": [
        [
          "峨眉山月半轮秋，影入平羌江水流。",
          "夜发清溪向三峡，思君不见下渝州。"
        ]
      ],
      "meaningSummary": "诗人由峨眉山月写到夜行江上，展现行舟之快，也抒发离乡时对友人的思念。",
      "keyNotes": [

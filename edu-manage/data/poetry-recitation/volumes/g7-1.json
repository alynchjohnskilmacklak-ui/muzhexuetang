    {
      "id": "g7-1-001",
      "sequence": 1,
      "title": "观沧海",
      "author": "曹操",
      "dynasty": "东汉末",
      "textbookSection": "古代诗歌四首",
      "contentType": "课内古诗",
      "genre": "四言古诗",
      "stanzas": [
        [
          "东临碣石，以观沧海。",
          "水何澹澹，山岛竦峙。"
        ],
        [
          "树木丛生，百草丰茂。",
          "秋风萧瑟，洪波涌起。"
        ],
        [
          "日月之行，若出其中；",
          "星汉灿烂，若出其里。"
        ],
        [
          "幸甚至哉，歌以咏志。"
        ]
      ],
      "meaningSummary": "诗人登临碣石山观海，以开阔壮丽的海景寄托胸怀天下、建功立业的豪情。",
      "keyNotes": [
        {
          "term": "澹澹",
          "meaning": "水波荡漾的样子"
        },
        {
          "term": "竦峙",
          "meaning": "高高耸立"
        }
      ],
      "assignmentPolicy": "教师或学校按范围布置",

      "dynasty": "唐",
      "textbookSection": "古代诗歌四首",
      "contentType": "课内古诗",
      "genre": "七言绝句",
      "stanzas": [
        [
          "杨花落尽子规啼，闻道龙标过五溪。",
          "我寄愁心与明月，随君直到夜郎西。"
        ]
      ],
      "meaningSummary": "诗人借暮春景物和明月寄托对被贬友人的牵挂与慰问。",

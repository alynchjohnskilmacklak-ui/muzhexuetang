# Fast, deployment-only runtime extension for an already verified application image.
# Keep BASE_IMAGE immutable/tagged before overwriting edu-manage-app:latest.
ARG BASE_IMAGE=edu-manage-app:base
FROM ${BASE_IMAGE}

USER root
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources \
  && apt-get update \
  && apt-get install -y --no-install-recommends jq postgresql-client \
  && rm -rf /var/lib/apt/lists/*

COPY --chown=node:node scripts/backup-now.sh ./scripts/backup-now.sh
COPY --chown=node:node scripts/backup-db.sh ./scripts/backup-db.sh
COPY --chown=node:node scripts/backup-uploads.sh ./scripts/backup-uploads.sh
RUN mkdir -p /app/.next/cache && chown -R node:node /app/.next/cache

USER node

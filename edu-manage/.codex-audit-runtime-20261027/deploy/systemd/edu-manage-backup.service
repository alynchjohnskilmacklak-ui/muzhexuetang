[Unit]
Description=Edu Manage full Docker backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/docker exec edu-manage-app-1 /bin/bash /app/scripts/backup-now.sh
ExecStartPost=/usr/bin/find /data/backups/edu-manage -mindepth 1 -maxdepth 1 -type d -name manual-* -mtime +14 -exec /usr/bin/rm -rf -- {} +


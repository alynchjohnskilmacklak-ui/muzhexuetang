    "P1_present_zero_by_review": {
      "sql": "SELECT l.\"intensiveReviewStatus\"::text, g.\"intensiveMode\"::text, count(*)::int AS n\n     FROM \"Attendance\" a JOIN \"ClassLesson\" l ON l.id=a.\"lessonId\"\n     LEFT JOIN \"ClassGroup\" g ON g.id=l.\"groupId\"\n     WHERE a.\"deletedAt\" IS NULL AND l.\"deletedAt\" IS NULL AND l.\"attendanceSubmittedAt\" IS NOT NULL\n       AND a.status='PRESENT' AND COALESCE(a.\"hoursDeducted\",0)=0\n     GROUP BY 1,2 ORDER BY n DESC",
      "rows": [
        {
          "intensiveReviewStatus": "APPROVED",
          "intensiveMode": "INTENSIVE",
          "n": 203
        },
        {
          "intensiveReviewStatus": "NOT_REQUIRED",
          "intensiveMode": "NORMAL",
          "n": 6
        },
        {
          "intensiveReviewStatus": "REJECTED",
          "intensiveMode": "INTENSIVE",
          "n": 1
        }
      ]
    },

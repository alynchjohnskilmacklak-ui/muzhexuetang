    "S3d_zero_deduct_by_status": {
      "sql": "SELECT a.status::text, count(*)::int AS rows,\n            count(*) FILTER (WHERE COALESCE(a.\"hoursDeducted\",0)=0)::int AS zero_deduct\n     FROM \"Attendance\" a\n     JOIN \"ClassLesson\" l ON l.id = a.\"lessonId\"\n     WHERE a.\"deletedAt\" IS NULL AND l.\"deletedAt\" IS NULL AND l.\"attendanceSubmittedAt\" IS NOT NULL\n     GROUP BY a.status ORDER BY rows DESC",
      "rows": [
        {
          "status": "PRESENT",
          "rows": 24235,
          "zero_deduct": 210
        },
        {
          "status": "LEAVE",
          "rows": 921,
          "zero_deduct": 3
        },
        {
          "status": "ABSENT",
          "rows": 9,
          "zero_deduct": 0
        }
      ]
    },

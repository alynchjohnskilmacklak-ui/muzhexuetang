    "G3d_overall_compare": {
      "sql": "SELECT count(*)::int AS active_students,\n            count(*) FILTER (WHERE ABS(s.\"remainHours\" - COALESCE(enr.sum,0)) > 0.05)::int AS mismatch,\n            count(*) FILTER (WHERE s.\"remainHours\" > 0 AND COALESCE(enr.sum,0) = 0)::int AS student_positive_enrollment_zero\n     FROM \"Student\" s\n     LEFT JOIN (SELECT \"studentId\", SUM(\"remainHours\")::float AS sum FROM \"Enrollment\"\n                WHERE status='ACTIVE' AND \"deletedAt\" IS NULL GROUP BY \"studentId\") enr\n       ON enr.\"studentId\" = s.id\n     WHERE s.\"deletedAt\" IS NULL",
      "rows": [
        {
          "active_students": 191,
          "mismatch": 136,
          "student_positive_enrollment_zero": 37
        }
      ]
    }

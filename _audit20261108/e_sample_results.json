    "S5b_duplicate_paykey": {
      "sql": "SELECT \"lessonPayKey\", count(*)::int AS n\n     FROM \"TeacherSalaryTransaction\"\n     WHERE \"deletedAt\" IS NULL AND \"lessonPayKey\" IS NOT NULL\n     GROUP BY \"lessonPayKey\" HAVING count(*) > 1 LIMIT 20",
      "rows": []
    },
    "S6a_orphan_attendance": {
      "sql": "SELECT count(*)::int AS n\n     FROM \"Attendance\" a\n     WHERE a.\"deletedAt\" IS NULL AND a.\"lessonId\" IS NOT NULL\n       AND NOT EXISTS (SELECT 1 FROM \"ClassLesson\" l WHERE l.id = a.\"lessonId\")",
      "rows": [
        {
          "n": 0
        }
      ]
    },
    "S6b_duplicate_lesson_student": {
      "sql": "SELECT \"lessonId\", \"studentId\", count(*)::int AS n\n     FROM \"Attendance\"\n     WHERE \"deletedAt\" IS NULL AND \"lessonId\" IS NOT NULL\n     GROUP BY \"lessonId\", \"studentId\"\n     HAVING count(*) > 1 LIMIT 20",
      "rows": []
    },
    "S6c_sample_orphan": {
      "sql": "SELECT a.id, s.name AS student, a.\"lessonId\", a.status, a.\"createdAt\"\n     FROM \"Attendance\" a LEFT JOIN \"Student\" s ON s.id = a.\"studentId\"\n     WHERE a.\"deletedAt\" IS NULL AND a.\"lessonId\" IS NOT NULL\n       AND NOT EXISTS (SELECT 1 FROM \"ClassLesson\" l WHERE l.id = a.\"lessonId\")\n     LIMIT 15",
      "rows": []
    },
    "S7_rollmarked_not_submitted": {
      "sql": "SELECT count(*) FILTER (WHERE a.\"rollCallMarkedAt\" IS NOT NULL)::int AS rollmarked,\n            count(*) FILTER (WHERE a.\"rollCallMarkedAt\" IS NOT NULL AND l.\"attendanceSubmittedAt\" IS NULL)::int AS rollmarked_not_submitted\n     FROM \"Attendance\" a\n     LEFT JOIN \"ClassLesson\" l ON l.id = a.\"lessonId\"\n     WHERE a.\"deletedAt\" IS NULL",
      "rows": [
        {
          "rollmarked": 0,
          "rollmarked_not_submitted": 0
        }
      ]
    },
    "S7b_sample_dangling": {
      "sql": "SELECT a.id, s.name AS student, l.\"lessonDate\", a.status, a.\"rollCallStatus\",\n            a.\"rollCallMarkedAt\", l.\"attendanceSubmittedAt\"\n     FROM \"Attendance\" a\n     LEFT JOIN \"Student\" s ON s.id = a.\"studentId\"\n     LEFT JOIN \"ClassLesson\" l ON l.id = a.\"lessonId\"\n     WHERE a.\"deletedAt\" IS NULL AND a.\"rollCallMarkedAt\" IS NOT NULL\n       AND l.\"attendanceSubmittedAt\" IS NULL\n     ORDER BY a.\"rollCallMarkedAt\" DESC LIMIT 20",
      "rows": []
    },
    "G3a_student_vs_enrollment_remain": {
      "sql": "SELECT s.id, s.name, s.\"remainHours\" AS student_remain,\n            COALESCE(SUM(e.\"remainHours\") FILTER (WHERE e.status='ACTIVE' AND e.\"deletedAt\" IS NULL),0)::float AS enrollment_sum,\n            count(e.id)::int AS active_enrollments\n     FROM \"Student\" s\n     LEFT JOIN \"Enrollment\" e ON e.\"studentId\" = s.id\n     WHERE s.\"deletedAt\" IS NULL\n     GROUP BY s.id, s.name, s.\"remainHours\"\n     HAVING ABS(s.\"remainHours\" - COALESCE(SUM(e.\"remainHours\") FILTER (WHERE e.status='ACTIVE' AND e.\"deletedAt\" IS NULL),0)) > 0.05\n     ORDER BY ABS(s.\"remainHours\" - COALESCE(SUM(e.\"remainHours\") FILTER (WHERE e.status='ACTIVE' AND e.\"deletedAt\" IS NULL),0)) DESC LIMIT 20",
